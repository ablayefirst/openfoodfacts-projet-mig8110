# =============================================
# CONFIGURATION DU PROJET OPENFOOD FACTS
# =============================================
# Instructions : copiez ce fichier en .env
# cp .env.example .env
# =============================================

# ----------------------------
# POSTGRESQL (DB métier - produits)
# ----------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=openfood_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_SCHEMA=public

# ----------------------------
# POSTGRESQL (DB Airflow metadata)
# ----------------------------
AIRFLOW_DB=airflow_metadata
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow123

# ----------------------------
# MINIO (S3 Compatible)
# ----------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold
MINIO_SECURE=false

# ----------------------------
# AIRFLOW
# ----------------------------
AIRFLOW_UID=50000
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__WEBSERVER__SECRET_KEY=openfood-secret-key-2024
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${AIRFLOW_DB_USER}:${AIRFLOW_DB_PASSWORD}@airflow-postgres:5432/${AIRFLOW_DB}

# ----------------------------
# JUPYTER
# ----------------------------
JUPYTER_TOKEN=openfood2024

# ----------------------------
# DASH APP
# ----------------------------
DASH_APP_PORT=8050
DASH_APP_HOST=0.0.0.0

# ----------------------------
# OPENFOOD FACTS EXPORTS
# ----------------------------
OPENFOOD_COUNTRY=canada
OPENFOOD_IMPORT_MODE=auto
OPENFOOD_MIN_CORE_NUTRIENTS=2
OPENFOOD_FULL_REFRESH_INTERVAL_DAYS=56
OPENFOOD_DELTA_RETENTION_DAYS=14
OPENFOOD_FULL_JSONL_URL=https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz
OPENFOOD_DELTA_INDEX_URL=https://static.openfoodfacts.org/data/delta/index.txt
OPENFOOD_DELTA_BASE_URL=https://static.openfoodfacts.org/data/delta
